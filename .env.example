# SCAFFOLD-SVC-002 — BFF Integration Layer. Copy to .env and fill in. Never commit real values.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=bff-integration-layer
 
# Recorded decisions (docs/decisions/SCAFFOLD-SVC-002.md)
CLOUD_PROVIDER=aws
API_STYLE=rest
QUEUE_BACKEND=sqs
SECRETS_BACKEND=aws-secrets-manager
AWS_REGION=us-east-1
 
# PostgreSQL — PII Isolated Data Store
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=bff
PG_USER=bff
PG_PASSWORD_SECRET_ID=bff/postgres/password
PG_POOL_MAX=10
 
# PostGIS — Geospatial Dealer Data Store
GEO_PG_HOST=localhost
GEO_PG_PORT=5432
GEO_PG_DATABASE=dealers
GEO_PG_USER=dealers
GEO_PG_PASSWORD_SECRET_ID=bff/geospatial/password
 
# Redis — session, ERP stock (5 min TTL), progressive profiling caches
REDIS_URL=redis://localhost:6379
REDIS_SESSION_PREFIX=session:
REDIS_ERP_STOCK_PREFIX=erp-stock:
REDIS_ERP_STOCK_TTL_SECONDS=300
REDIS_PROFILE_PREFIX=profile:
 
# AWS SQS — Durable Message Queue (enriched lead payloads)
SQS_LEAD_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/enriched-leads
 
# AWS Secrets Manager — runtime credential retrieval
SECRETS_MANAGER_PREFIX=bff/
 
# AWS S3 — Driver/Firmware Metadata Store
S3_FIRMWARE_BUCKET=driver-firmware-metadata
 
# Gated content tokens (secret fetched at runtime by id)
JWT_SIGNING_SECRET_ID=bff/jwt/signing-key
HMAC_SECRET_ID=bff/hmac/key
 
# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=bff-integration-layer
 
# Circuit breaker (opossum)
CB_TIMEOUT_MS=3000
CB_ERROR_THRESHOLD_PERCENT=50
CB_RESET_TIMEOUT_MS=30000
